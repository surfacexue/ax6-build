# 第三条线：Redmi AX6 单槽 stock 布局 + OpenWrt ppe-nss（Linux 6.18）
# 基线 = Steven-ZYC/AX6-OpenWrt-Tiny 的 ppe-tiny（无代理），本线改动：
#   1. 加回 tailscale + WireGuard 四件套（NAS 外网访问）
#   2. NSS 固件走 12.5 Release 210（不是默认的 11.4.0.5 Release 6）
#   3. 体积 gate 从 28 MiB 放宽到 64 MiB（见 scripts/check-stock-image.py，
#      28 MiB 是原厂 A/B 单槽 35.75 MiB 的保守值，本机 mtd12 是 102.25 MiB）
# 与 #12（qosmio 6.12.91 + ECM）的区别：本线走 PPE/EDMA 有线转发 + NSS WiFi，
# 不装 qca-nss-ecm（下方显式 not set），两套加速架构互斥，别混。

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6-stock=y
# CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6 is not set
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024

# 有线：PPE/EDMA 由内核提供，不是供应商 NSS 包
CONFIG_PACKAGE_ppe-help=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_firewall4=y

# 无线：NSS WiFi 走与 PPE/EDMA 共存的新驱动，不用旧 ECM 栈
CONFIG_PACKAGE_kmod-nss-wifi-drv=y
CONFIG_ATH11K_NSS_WIFI=y
CONFIG_PACKAGE_nss-firmware=y
CONFIG_PACKAGE_nss-firmware-ipq807x=y
# 12.5 Release 210 是 IPQ807x 最后一个公开 release；代价是不支持 802.11s mesh
# （nss-firmware Makefile 的 help 明写 12.x 均不支持 NSS MESH，11.4 才支持）
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
# 切 12.5 后 qca-nss-drv 会自动跟到 2024-11-13 / QSDK 12.5（Makefile 里 11_4 才降级）
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# PPE tc offload 的用户态与内核动作支持
CONFIG_PACKAGE_tc-tiny=y
CONFIG_PACKAGE_kmod-sched-flower=y
CONFIG_PACKAGE_kmod-sched-prio=y
CONFIG_PACKAGE_kmod-sched-act-police=y
CONFIG_PACKAGE_kmod-sched-act-pedit=y
CONFIG_PACKAGE_kmod-sched-act-vlan=y
CONFIG_PACKAGE_kmod-sched-mqprio=y
CONFIG_PACKAGE_kmod-sched-red=y

# LuCI：HTTPS + Argon + 简体中文
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_ca-bundle=y

# ★ 本线新增：NAS 外网访问
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_rpcd-mod-wireguard=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_tailscale=y
# tailscale 需要 Go >= 1.27（go.mod 声明 1.27.3），ppe-nss 的 packages feed 跟
# openwrt master，自带 golang1.27，故不再像旧树那样手工替换工具链

# 配套常用件（与当前系统对齐）
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_ddns-scripts=y
# ddns 的图形界面（2026-11-28 增补）：上一版只有 ddns-scripts 守护进程，
# LuCI 里没有"动态 DNS"页面，改 provider / 看更新日志只能 uci 手工来。
# 纯 noarch 界面包，依赖 luci-base + ddns-scripts（都已在），不牵内核。
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_openssh-sftp-server=y

# ★ 排障工具（2026-11-28 增补）
# 上一版固件出门时，iperf3 / tcpdump / openssl 命令行全缺，
# 想压测吞吐、抓包排查、手工签证书都得先联网 apk add——而换机现场恰恰没网。
# 体积合计约 1 MiB，64 MiB 门限下可忽略。
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_openssl-util=y

# ★ 崩溃现场保留（2026-11-28 增补）
# 设备树已给 ramoops 留了 1 MiB（ramoops@51200000, nomap non-reusable），
# 但上一版内核没编 pstore，/sys/fs/pstore 根本不存在，oops/异常重启抓不到现场。
# kmod-ramoops 的 KCONFIG 会带上 CONFIG_PSTORE / _CONSOLE / _RAM，
# 依赖自动拉 kmod-pstore + kmod-reed-solomon。
# 挂载与上次崩溃的转存由 files/etc/rc.local 负责（每次启动检查一次）。
CONFIG_PACKAGE_kmod-ramoops=y

# ★ 代理：HomeProxy + sing-box-tiny（与 AX6-OpenWrt-Tiny 的 Tiny Plus 同一套）
# 界面取自 ImmortalWrt luci（openwrt 官方 luci 没有），内核 sing-box 来自 packages feed。
# prepare.sh 3/6 把 HomeProxy 的 +sing-box 依赖改成 +sing-box-tiny；
# 6/6 再把 sing-box-tiny 的编译选项去掉 QUIC 与 gVisor，只留 uTLS + Clash API。
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y
CONFIG_PACKAGE_sing-box-tiny=y
# CONFIG_PACKAGE_sing-box is not set
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_ucode-mod-digest=y

# ★ 网页终端与文件管理（Tiny Plus 同款；无 SCP 客户端也能改配置）
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-filemanager=y

# ★ UPnP / NAT-PMP（孩子游戏联机、端口自动映射）
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_rpcd-mod-ucode=y

# ★ FullCone NAT（UDP 全锥形，改善 P2P / 联机）
# 由 ppe/pkgs/ 提供：内核模块 + nftables/libnftnl 补丁 + firewall4 开关 + LuCI 页
# （只有内核模块是没用的，官方用户态根本不认 fullcone 表达式）
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_luci-app-fullcone=y
CONFIG_PACKAGE_nftables-json=y

# ★ 广告过滤（adblock-fast，跟着 dnsmasq-full 走）
CONFIG_PACKAGE_luci-app-adblock-fast=y
CONFIG_PACKAGE_luci-i18n-adblock-fast-zh-cn=y
CONFIG_PACKAGE_adblock-fast=y

# ★ dnsmasq 换 full 变体（adblock-fast 的 nftset 拦截靠它）
# dnsmasq / dnsmasq-dhcpv6 / dnsmasq-full 三个变体装的是同一组文件：
#   /usr/sbin/dnsmasq、/etc/config/dhcp、/etc/init.d/dnsmasq
# 同时选会像 LibWrt 的 mosdns 那样在 package/install 阶段报
# "trying to overwrite"，所以必须整组替换，不能只加一行。
# 普通变体的 COPTS 带 -DNO_AUTH -DNO_IPSET -DNO_ID，没编 HAVE_NFTSET；
# 只有 full 变体才编入 nftset，adblock-fast 才能用 nftset 后端（走 nft 集合，
# 不写几千行 conf）。主线 #15 实测过这套写法在 make defconfig 下有效，
# 产物 manifest 是 dnsmasq-full 2.91-r3，普通 dnsmasq 为 not set。
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_dnsmasq-dhcpv6 is not set
CONFIG_PACKAGE_dnsmasq-full=y
# ppe-nss 的 dnsmasq 带 +@BUSYBOX_CONFIG_PIDOF 硬依赖（pin 的 7d65a3e 就有）。
# run #2 实测 dnsmasq=y 与 PIDOF=n 并存且编出可用镜像，说明这条 @ 依赖在
# kconfig 层并没有真正挡住包选择；但"硬依赖没生效"本身不可依赖，
# 显式打开 PIDOF 把不确定性消掉。代价：busybox 多一个 pidof applet（约 2 KB）。
CONFIG_BUSYBOX_CONFIG_PIDOF=y
# full 的子选项：默认值本来就是 nftset/dnssec/dhcpv6/conntrack/auth/noid/tftp
# 全开、ipset 关，显式写出是为了不依赖默认值（dnssec 拉 libnettle、
# conntrack 拉 libnetfilter-conntrack，nftset 拉 nftables-json，后者已在上面）
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
# CONFIG_PACKAGE_dnsmasq_full_ipset is not set
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y

# 仍然不装完整版 sing-box
# CONFIG_PACKAGE_sing-box is not set
# mosdns 这两行是"意图声明"，不是有效配置：ppe-nss 的 packages feed 里没有
# mosdns 本体（run #2 的 build.config 实测 CONFIG_PACKAGE_mosdns 符号不存在，
# defconfig 阶段被静默丢弃），luci 界面倒是存在但缺本体装了也起不来。
# 保留是为了意图留痕，且上游若哪天加回该包，这两行能挡住。
# CONFIG_PACKAGE_mosdns is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set

# 显式拒绝旧 5.10 供应商 NSS / ECM / Shortcut-FE 栈（与 PPE 架构互斥）
# CONFIG_PACKAGE_qca-nss-ecm is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv-64 is not set
# CONFIG_PACKAGE_kmod-shortcut-fe is not set
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set

# 编译器复用（CI 上启用 ccache）
# 只写 CONFIG_CCACHE=y 是无效的：它在这棵树里定义成
#   config CCACHE
#       bool "Use ccache" if DEVEL
# 没开 DEVEL 时该符号不可见，defconfig 直接丢弃——run #2 的 build.config
# 里只剩一个孤零零的 CONFIG_CCACHE_DIR=""（它没有 depends，所以总会出现），
# 就是这个原因。主线 #15 的 config.buildinfo 也是 DEVEL+CCACHE 这一对。
# DEVEL 的副作用只有 AUTOREBUILD 默认变 y（make 时检查包时间戳），
# CI 全新 build_dir 下没有额外开销，主线就是带着它跑的。
# 不开 CCACHE_DIR，默认用 $(TOPDIR)/.ccache，正好是 workflow 缓存的
# ppe-source/.ccache，路径天然对得上。
CONFIG_DEVEL=y
CONFIG_CCACHE=y
