# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# ---- pstore / ramoops：转存上次崩溃现场 ----
# 设备树给 ramoops 留了 1 MiB（ramoops@51200000, nomap non-reusable），
# kmod-ramoops 提供后端，pstore.ko 建立文件系统。
# 这里每次启动挂一次；有内容说明上次是 oops/panic/异常掉电，
# 追加到 overlay 上的单一归档后清空 pstore，避免同一条记录反复累积。
if [ -d /sys/fs/pstore ]; then
	mount | grep -q "on /sys/fs/pstore type pstore" || mount -t pstore pstore /sys/fs/pstore 2>/dev/null
	if ls /sys/fs/pstore/* >/dev/null 2>&1; then
		mkdir -p /etc/pstore-archive
		{
			echo "===== boot $(date '+%Y-%m-%d %H:%M:%S') ====="
			cat /sys/fs/pstore/* 2>/dev/null
			echo
		} >> /etc/pstore-archive/last-crash.log
		rm -f /sys/fs/pstore/* 2>/dev/null
		# 归档不无限增长：只留最后约 200 KB
		if [ "$(wc -c < /etc/pstore-archive/last-crash.log 2>/dev/null || echo 0)" -gt 204800 ]; then
			tail -c 204800 /etc/pstore-archive/last-crash.log > /tmp/.pstore.trim
			mv /tmp/.pstore.trim /etc/pstore-archive/last-crash.log
		fi
	fi
fi

exit 0
