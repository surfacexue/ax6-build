# Redmi AX6 功能完整版编译配置（LibWrt 25.12-nss）
#
# 定位：与「当前在用系统」功能对齐的 LibWrt 版本 —— 内核 6.12.116，
#       NSS/ECM 硬件加速（与现系统同架构），保留 WireGuard / tailscale /
#       流量统计 / DDNS / WoL / 主题等日常在用的东西。
#
# 底座：LiBwrt/LibWrt 分支 25.12-nss（feeds 已自带 immortalwrt 25.12 的
#       packages 与 luci，且原生提供 redmi_ax6-stock 设备定义）。
#       NSS 部分来自 feeds: laipeng668/nss-packages 分支 NSS-LibWrt。
#
# 与 massivehard2014/ax6-nss-pure 那份「纯净版」的关系：
#       NSS 核心段（目标设备 / 三件套 / 固件 / 内存 profile / DRV 开关 /
#       子模块）整段照抄并逐行核实，因为那部分作者已在 LibWrt 上编过；
#       其余功能包由本文件补齐，全部包名取自当前 ax6.config（371 个 =y
#       里筛出的用户可见包），避免手写拼错符号。
#
# 重要：`make defconfig` 会静默丢弃本树不存在的符号。构建流程里有一道
#       审计步骤，把「核心包缺失」判为失败、「增强项缺失」判为告警并写入
#       job summary，所以不要只看这个文件判断最终固件内容。
#
# 设备说明：redmi_ax6 = expand layout（kernel 36MB + rootfs 双卷，供首次
#       ubiformat 刷入）；redmi_ax6-stock = custom U-Boot 单卷（本机现状，
#       board_name = redmi,ax6-stock，mtd 里没有 kernel 分区）。

# ---------- 目标平台与机型 ----------
# 注意：下面这四行字符串符号是「选择目标」的钥匙，缺了它们 make defconfig
# 拿不到目标上下文，TARGET_DEVICE_* 那个 bool 符号不在候选里、会被静默丢弃，
# 于是「应用编译配置」那一步的硬校验报 "redmi_ax6-stock 未启用"（run #1 即死于此）。
CONFIG_TARGET_BOARD="qualcommax"
CONFIG_TARGET_SUBTARGET="ipq807x"
CONFIG_TARGET_PROFILE="DEVICE_redmi_ax6-stock"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53+crc+crypto"
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_redmi_ax6-stock=y

# ---------- NSS 核心三件套（缺一不可）----------
CONFIG_PACKAGE_kmod-qca-ssdk=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
# ECM：把连接卸载到 NSS 的连接管理器；不装等于没加速
CONFIG_PACKAGE_kmod-qca-nss-ecm=y

# ---------- NSS 固件（AX6 属 ipq807x）----------
CONFIG_PACKAGE_nss-firmware=y
CONFIG_PACKAGE_nss-firmware-ipq807x=y
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

# ---------- NSS 内存 profile：本机 392MiB，必须 MEDIUM ----------
# 默认值是 HIGH(1G)，不显式关掉的话 defconfig 会保留默认、MEDIUM 不生效。
# CONFIG_NSS_MEM_PROFILE_HIGH is not set
CONFIG_NSS_MEM_PROFILE_MEDIUM=y
# CONFIG_NSS_MEM_PROFILE_LOW is not set

# ---------- NSS 功能开关 ----------
CONFIG_NSS_DRV_BRIDGE_ENABLE=y
CONFIG_NSS_DRV_PPPOE_ENABLE=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_NSS_DRV_IGS_ENABLE=y
CONFIG_NSS_DRV_SHAPER_ENABLE=y
CONFIG_NSS_DRV_MATCH_ENABLE=y
CONFIG_NSS_DRV_GRE_ENABLE=y
CONFIG_NSS_DRV_PVXLAN_ENABLE=y
CONFIG_NSS_DRV_TUN6RD_ENABLE=y
CONFIG_NSS_DRV_TUNIPIP6_ENABLE=y
CONFIG_NSS_DRV_IPV6_ENABLE=y
CONFIG_NSS_DRV_VIRT_IF_ENABLE=y

# ---------- NSS 客户端子模块 ----------
CONFIG_PACKAGE_kmod-nss-ifb=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tun6rd=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tunipip6=y
CONFIG_PACKAGE_kmod-qca-nss-drv-gre=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pvxlanmgr=y

# ---------- WiFi：ath11k（QCN5024 / QCN5054）----------
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_ath11k-firmware-ipq8074=y
# WiFi 走 NSS 的开关由 mac80211 的 nss 补丁提供（LibWrt 树内 patches/nss）。
# 若该树改为独立包名，审计步骤会告警，届时按实际符号替换。
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y

# ---------- PPPoE ----------
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# ---------- 外网访问 NAS：WireGuard + tailscale ----------
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_rpcd-mod-wireguard=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_tailscale=y

# ---------- HTTPS 管理页 ----------
# LibWrt 树内有 package/utils/px5g-openssl，所以这里不像主线那样需要改依赖。
CONFIG_PACKAGE_luci-ssl-openssl=y

# ---------- LuCI 基础与中文 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

# ---------- 主题 ----------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ---------- DNS / 代理类（与现系统一致）----------
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_mosdns=y
# 不要装 sbwml 的接口包：它的 root/etc/ 里带着 init.d/mosdns、config/mosdns、
# mosdns/ 模板，与 feed 的 mosdns-5.3.3 完全重叠。这棵树用 opkg，装包阶段会
# 硬失败（run #3：trying to overwrite etc/init.d/mosdns owned by mosdns-5.3.3-r1）。
# 主线走 apk，覆盖就过去了，所以主线装同一组合没事 —— 别照抄。
# 需要的只是 mosdns 本体，配置从现系统 sysupgrade -b 迁过来即可。
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn is not set
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
# openclash 的界面在 immortalwrt/luci，内核包在并入的 package/new 里
CONFIG_PACKAGE_luci-app-openclash=y
# openclash 依赖 ruby；ruby 的 YJIT 打开就会连带编 rust/host（immortalwrt 的 ruby
# Makefile 写着 PKG_BUILD_DEPENDS:=ruby/host RUBY_ENABLE_YJIT:rust/host）。
# rustc 1.96 的 bootstrap 要从 ci 下载 LLVM，run #2 就是死在
# "ERROR: failed to download llvm from ci"，白编 50 分钟。YJIT 对 OpenClash 没用，
# 关掉它既去掉这个易碎下载，也省掉约 40 分钟的 rust 自举。
# CONFIG_RUBY_ENABLE_YJIT is not set

# ---------- 加速 / 流量整形 ----------
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_NFT_FULLCONE=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y

# ---------- 防火墙增强 ----------
# fullcone：nft 版才在 fw4 下生效，ipt 版是摆设
CONFIG_PACKAGE_kmod-nft-fullcone=y
# nathelper：RTSP/FTP/PPTP/SIP 穿透
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y
CONFIG_PACKAGE_kmod-nf-nathelper-rtsp=y

# ---------- 常用服务 ----------
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_cpufreq=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

# ---------- 存储 / USB ----------
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_zram-swap=y

# ---------- 排障工具 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_resolveip=y

# ---------- 明确关闭：避免误装不需要的东西 ----------
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-sing-box is not set
# CONFIG_PACKAGE_luci-app-v2raya is not set
# CONFIG_PACKAGE_luci-app-ddns-go is not set
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_sing-box is not set
