+          path: /mnt/ax6build/openwrt/.ccache
           key: ccache-${{ github.run_id }}
           restore-keys: |
             ccache-
 
       - name: 更新 feeds（luci 固定到 immortalwrt openwrt-25.12）
         run: |
+          # 先把 ccache 容量钉住：本树 rules.mk 强制 CCACHE_NOCOMPRESS=true（缓存不压缩），
+          # 不设上限会一路涨到默认值，与 74G 构建树抢空间。放在恢复后执行，避免被缓存里的
+          # 旧 ccache.conf 覆盖。这里不新增步骤，保持下文「第 N 步」的编号不变。
+          mkdir -p /mnt/ax6build/openwrt/.ccache
+          ccache --max-size=4G
+          echo "--- ccache 配置 ---"
+          (ccache --show-config 2>/dev/null || ccache -p) | grep -iE 'max_size|compress' || true
