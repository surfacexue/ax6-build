index 0000000000..70c390cc85
--- /dev/null
+++ b/target/linux/qualcommax/ipq50xx/base-files/etc/uci-defaults/15_ra81_ecm_gro_list
@@ -0,0 +1,13 @@
+#!/bin/sh
+# Xiaomi Redmi AX3000 (RA81, 256 MiB): fraglist GRO off through ECM's own
+# option, as 15_cr8806_ecm_gro_list does for the CR8806 (same SoC and memory).
+
+. /lib/functions.sh
+
+[ "$(board_name)" = xiaomi,redmi-ax3000 ] || exit 0
+uci -q get ecm.general > /dev/null || exit 0
+
+uci -q set ecm.general.disable_gro_list='1'
+uci -q commit ecm
+
+exit 0
