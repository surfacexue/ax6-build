diff --git a/target/linux/qualcommax/ipq50xx/base-files/etc/uci-defaults/15_ra81_ecm_gro_list b/target/linux/qualcommax/ipq50xx/base-files/etc/uci-defaults/15_ra81_ecm_gro_list
