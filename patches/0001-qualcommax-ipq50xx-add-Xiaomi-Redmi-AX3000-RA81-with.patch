 	xiaomi_mi-router-ax3000t-v2 \
 	xiaomi_ra80 \
@@ -384,6 +385,7 @@ $(eval $(call generate-ipq-wifi-package,xiaomi_aiot-ac2350,Xiaomi AIoT AC2350))
