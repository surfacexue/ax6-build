diff --git a/target/linux/qualcommax/dts/ipq5018-redmi-ax3000.dts b/target/linux/qualcommax/dts/ipq5018-redmi-ax3000.dts
new file mode 100644
index 0000000000..4c38d997f4
--- /dev/null
+++ b/target/linux/qualcommax/dts/ipq5018-redmi-ax3000.dts
@@ -0,0 +1,519 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/dts-v1/;
+
+#include "ipq5018.dtsi"
+#include "ipq5018-ess.dtsi"
+#include "ipq5018-qcn6122.dtsi"
+#include "ipq5018-nss.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "Xiaomi Redmi AX3000";
+	compatible = "xiaomi,redmi-ax3000", "qcom,ipq5018";
+
+	reserved-memory {
+		q6_region_qcn6122_1: q6-region-qcn6122-1@4d200000 {
+			reg = <0x0 0x4d200000 0x0 0xd00000>;
+			no-map;
+		};
+
+		m3_dump_qcn6122_1: m3-dump-qcn6122-1@4df00000 {
+			reg = <0x0 0x4df00000 0x0 0x100000>;
+			no-map;
+		};
+	};
+
+	aliases {
+		serial0 = &blsp1_uart1;
+		label-mac-device = &gmac1;
+		led-boot = &led_status_blue;
+		led-failsafe = &led_status_yellow;
+		led-running = &led_status_blue;
+		led-upgrade = &led_status_yellow;
+	};
+
+	chosen {
+		/*
+		 * The stock U-Boot (bootmiwifi) selects one of the two UBI
+		 * slots and passes "ubi.mtd=rootfs" or "ubi.mtd=rootfs_1"
+		 * together with "root=mtd:ubi_rootfs". Keep its ubi.mtd and
+		 * only override the root device.
+		 *
+		 * coherent_pool=512K as on the other 256 MiB boards.
+		 */
+		bootargs-append = " root=/dev/ubiblock0_1 swiotlb=1 coherent_pool=512K";
+		stdout-path = "serial0:115200n8";
+	};
+
+	keys {
+		compatible = "gpio-keys";
+		pinctrl-0 = <&button_pins>;
+		pinctrl-names = "default";
+
+		reset-button {
+			label = "reset";
+			gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+			debounce-interval = <60>;
+		};
+
+		mesh-button {
+			label = "mesh";
+			gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_WPS_BUTTON>;
+			debounce-interval = <60>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+		pinctrl-0 = <&led_pins>;
+		pinctrl-names = "default";
+
+		led_status_yellow: led-0 {
+			gpios = <&tlmm 17 GPIO_ACTIVE_HIGH>;
+			color = <LED_COLOR_ID_YELLOW>;
+			function = LED_FUNCTION_STATUS;
+		};
+
+		led_status_blue: led-1 {
+			gpios = <&tlmm 19 GPIO_ACTIVE_HIGH>;
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_STATUS;
+		};
+
+		led-2 {
+			gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
+			color = <LED_COLOR_ID_YELLOW>;
+			function = LED_FUNCTION_WAN;
+		};
+
+		led-3 {
+			gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_WAN;
+		};
+	};
+};
+
+/*
+ * The vendor firmware reserves 4 MiB for TZ here (the IPQ5018 default
+ * is 2 MiB); keep Linux out of the whole region.
+ */
+&tz_region {
+	reg = <0x0 0x4ac00000 0x0 0x400000>;
+};
+
+/*
+ * TSENS is not enabled by the boot firmware on this IPQ5000 ("tsens
+ * device is not enabled" with the vendor kernel) and some of its zones
+ * report bogus critical temperatures, which shuts the board down early
+ * in boot - before the dual-boot rollback is armed. Keep it off.
+ */
+&tsens {
+	status = "disabled";
+};
+
+&sleep_clk {
+	clock-frequency = <32000>;
+};
+
+&xo_board_clk {
+	clock-div = <4>;
+	clock-mult = <1>;
+};
+
+&blsp1_uart1 {
+	status = "okay";
+
+	pinctrl-0 = <&serial_0_pins>;
+	pinctrl-names = "default";
+};
+
+&prng {
+	status = "okay";
+};
+
+&qfprom {
+	status = "okay";
+};
+
+&qpic_bam {
+	status = "okay";
+};
+
+&qpic_nand {
+	pinctrl-0 = <&qpic_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	/* GigaDevice GD5F1GQ5REYIG, 128 MiB */
+	nand@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		nand-ecc-engine = <&qpic_nand>;
+		/* Must match the factory/QSDK layout (BCH8, 512-byte steps) */
+		nand-ecc-step-size = <512>;
+		nand-ecc-strength = <8>;
+		nand-bus-width = <8>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "0:SBL1";
+				reg = <0x0 0x80000>;
+			};
+
+			partition@80000 {
+				label = "0:MIBIB";
+				reg = <0x80000 0x80000>;
+			};
+
+			partition@100000 {
+				label = "0:BOOTCONFIG";
+				reg = <0x100000 0x40000>;
+			};
+
+			partition@140000 {
+				label = "0:BOOTCONFIG1";
+				reg = <0x140000 0x40000>;
+			};
+
+			partition@180000 {
+				label = "0:QSEE";
+				reg = <0x180000 0x100000>;
+			};
+
+			partition@280000 {
+				label = "0:QSEE_1";
+				reg = <0x280000 0x100000>;
+			};
+
+			partition@380000 {
+				label = "0:DEVCFG";
+				reg = <0x380000 0x40000>;
+			};
+
+			partition@3c0000 {
+				label = "0:DEVCFG_1";
+				reg = <0x3c0000 0x40000>;
+			};
+
+			partition@400000 {
+				label = "0:CDT";
+				reg = <0x400000 0x40000>;
+			};
+
+			partition@440000 {
+				label = "0:CDT_1";
+				reg = <0x440000 0x40000>;
+			};
+
+			partition@480000 {
+				label = "0:APPSBLENV";
+				reg = <0x480000 0x80000>;
+			};
+
+			partition@500000 {
+				label = "0:APPSBL";
+				reg = <0x500000 0x140000>;
+			};
+
+			partition@640000 {
+				label = "0:APPSBL_1";
+				reg = <0x640000 0x140000>;
+			};
+
+			partition@780000 {
+				label = "0:ART";
+				reg = <0x780000 0x100000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					macaddr_art_0: mac-address@0 {
+						compatible = "mac-base";
+						reg = <0x0 0x6>;
+						#nvmem-cell-cells = <1>;
+					};
+
+					macaddr_art_6: mac-address@6 {
+						compatible = "mac-base";
+						reg = <0x6 0x6>;
+						#nvmem-cell-cells = <1>;
+					};
+				};
+			};
+
+			partition@880000 {
+				label = "0:TRAINING";
+				reg = <0x880000 0x80000>;
+			};
+
+			partition@900000 {
+				label = "bdata";
+				reg = <0x900000 0x80000>;
+			};
+
+			partition@980000 {
+				label = "crash";
+				reg = <0x980000 0x80000>;
+			};
+
+			partition@a00000 {
+				label = "crash_log";
+				reg = <0xa00000 0x80000>;
+			};
+
+			partition@a80000 {
+				label = "rootfs";
+				reg = <0xa80000 0x7480000>;
+			};
+		};
+	};
+};
+
+/*
+ * ===============================================================
+ *     _______________________         _______________________
+ *    |        IPQ5000        |       |        QCA8337        |
+ *    | +------+   +--------+ |       | +--------+   +------+ |
+ *    | | MAC0 |---| GE Phy |-+--UTP--+-|  Phy4  |---| MAC5 | |
+ *    | +------+   +--------+ |       | +--------+   +------+ |
+ *    | +------+   +--------+ |       | +--------+   +------+ |
+ *    | | MAC1 |---| Uniphy |-+-SGMII-+-| SerDes |---| MAC6 | |
+ *    | +------+   +--------+ |       | +--------+   +------+ |
+ *    |_______________________|       |_______________________|
+ *
+ * QCA8337 Phy0..Phy2 -> LAN1..LAN3, Phy3 -> WAN.
+ * Only the SGMII link (MAC1 <-> MAC6) is used as the DSA CPU port,
+ * the same arrangement as the vendor firmware's eth1 (switch port 6)
+ * and the Linksys MX2000.
+ * ===============================================================
+ */
+
+&uniphy0 {
+	status = "okay";
+
+	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
+	assigned-clock-rates = <UNIPHY_REFCLK_25MHZ>;
+};
+
+// MAC1 ---SGMII---> QCA8337 SerDes
+&gmac1 {
+	status = "okay";
+
+	phy-mode = "sgmii";
+
+	nvmem-cells = <&macaddr_art_6 0>;
+	nvmem-cell-names = "mac-address";
+
+	fixed-link {
+		speed = <1000>;
+		full-duplex;
+	};
+};
+
+&mdio0 {
+	status = "okay";
+};
+
+&mdio1 {
+	status = "okay";
+
+	pinctrl-0 = <&mdio1_pins>;
+	pinctrl-names = "default";
+	reset-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
+
+	// QCA8337 Phy0 -> LAN1
+	qca8337_0: ethernet-phy@0 {
+		reg = <0>;
+	};
+
+	// QCA8337 Phy1 -> LAN2
+	qca8337_1: ethernet-phy@1 {
+		reg = <1>;
+	};
+
+	// QCA8337 Phy2 -> LAN3
+	qca8337_2: ethernet-phy@2 {
+		reg = <2>;
+	};
+
+	// QCA8337 Phy3 -> WAN
+	qca8337_3: ethernet-phy@3 {
+		reg = <3>;
+	};
+
+	// QCA8337 Phy4 -> IPQ5000 GE Phy (unused)
+	qca8337_4: ethernet-phy@4 {
+		reg = <4>;
+	};
+
+	switch1: ethernet-switch@17 {
+		compatible = "qca,qca8337";
+		reg = <17>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		ethernet-ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			ethernet-port@1 {
+				reg = <1>;
+				label = "lan1";
+				phy-handle = <&qca8337_0>;
+			};
+
+			ethernet-port@2 {
+				reg = <2>;
+				label = "lan2";
+				phy-handle = <&qca8337_1>;
+			};
+
+			ethernet-port@3 {
+				reg = <3>;
+				label = "lan3";
+				phy-handle = <&qca8337_2>;
+			};
+
+			ethernet-port@4 {
+				reg = <4>;
+				label = "wan";
+				phy-handle = <&qca8337_3>;
+
+				nvmem-cells = <&macaddr_art_0 0>;
+				nvmem-cell-names = "mac-address";
+			};
+
+			ethernet-port@6 {
+				reg = <6>;
+				label = "cpu";
+				phy-mode = "sgmii";
+				ethernet = <&gmac1>;
+				qca,sgmii-enable-pll;
+
+				fixed-link {
+					speed = <1000>;
+					full-duplex;
+				};
+			};
+		};
+	};
+};
+
+&tlmm {
+	button_pins: button-state {
+		pins = "gpio23", "gpio25";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+
+	led_pins: led-state {
+		pins = "gpio17", "gpio19", "gpio20", "gpio22";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-down;
+	};
+
+	mdio1_pins: mdio-state {
+		mdc-pins {
+			pins = "gpio36";
+			function = "mdc";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+
+		mdio-pins {
+			pins = "gpio37";
+			function = "mdio";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+	};
+
+	qpic_pins: qpic-state {
+		clock-pins {
+			pins = "gpio9";
+			function = "qspi_clk";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		cs-pins {
+			pins = "gpio8";
+			function = "qspi_cs";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		data-pins {
+			pins = "gpio4", "gpio5", "gpio6", "gpio7";
+			function = "qspi_data";
+			drive-strength = <8>;
+			bias-disable;
+		};
+	};
+
+	serial_0_pins: uart0-state {
+		pins = "gpio28", "gpio29";
+		function = "blsp0_uart1";
+		drive-strength = <8>;
+		bias-disable;
+	};
+};
+
+&q6v5_wcss {
+	/* QCN6102 radio on PCIe1, user PD 2, reset on GPIO27 */
+	boot-args = </*       type:	*/ 0x2 /* PCIE1	*/
+		     /*     length:	*/ 4
+		     /*     UPD ID:	*/ 2
+		     /* reset GPIO:	*/ 27
+		     /*   reserved:	*/ 0 0>;
+	status = "okay";
+};
+
+/*
+ * 256 MiB of RAM: use the low-memory firmware profile (mode 2), as the
+ * vendor firmware does (qcom,tgt-mem-mode = <2>). Memory layout as on the
+ * CR8806, which shares the SoC, radios and boot firmware with the RA81.
+ */
+&wifi {
+	status = "okay";
+	ieee80211-freq-limit = <2400000 2483000>;
+
+	// IPQ5000 2.4 GHz
+	qcom,rproc = <&q6v5_wcss>;
+	qcom,ath11k-calibration-variant = "Xiaomi-Redmi-AX3000";
+	qcom,ath11k-fw-memory-mode = <2>;
+};
+
+&wifi1 {
+	status = "okay";
+
+	// QCN6102 5 GHz
+	qcom,rproc = <&q6v5_wcss>;
+	qcom,ath11k-calibration-variant = "Xiaomi-Redmi-AX3000";
+	qcom,ath11k-fw-memory-mode = <2>;
+	ieee80211-freq-limit = <5150000 5850000>;
+
+	memory-region = <&q6_region_qcn6122_1>, <&q6_region_ipq5018>, <&m3_dump_qcn6122_1>;
+	memory-region-names = "q6-region", "m3-region", "m3-dump";
+};
+
+/* 256 MB board: NSS heap 8 MiB, as on the other QCN6122 256 MB boards */
+&nss_region {
+	reg = <0x0 0x40000000 0x0 0x800000>;
+};
diff --git a/target/linux/qualcommax/image/ipq50xx.mk b/target/linux/qualcommax/image/ipq50xx.mk
index c2641f95d1..4038083270 100644
--- a/target/linux/qualcommax/image/ipq50xx.mk
+++ b/target/linux/qualcommax/image/ipq50xx.mk
@@ -332,6 +332,32 @@ define Device/xiaomi_ra80
 endef
 TARGET_DEVICES += xiaomi_ra80
 
+define Device/xiaomi_redmi-ax3000
+	$(call Device/FitImage)
+	$(call Device/UbiFit)
+	DEVICE_VENDOR := Xiaomi
+	DEVICE_MODEL := Redmi AX3000
+	DEVICE_VARIANT := (RA81)
+	DEVICE_DTS_CONFIG := config@mp02.1
+	SOC := ipq5018
+	BLOCKSIZE := 128k
+	PAGESIZE := 2048
+	NAND_SIZE := 128m
+	# The fixed rootfs partition is 116.5 MiB (0x7480000) and holds a single
+	# set of kernel/rootfs/rootfs_data volumes. This cap is kept at the value
+	# of the former 36 MiB dual-boot slot: it only rejects oversized images
+	# and stays well above the 16.4 MB this board's factory image needs.
+	IMAGE_SIZE := 30720k
+	SUPPORTED_DEVICES += redmi,ax3000
+	# No USB port and NAND-only storage on this board
+	DEVICE_PACKAGES := \
+		ath11k-firmware-ipq5018-qcn6122 \
+		ipq-wifi-xiaomi_redmi-ax3000 \
+		-kmod-usb3 -kmod-usb-dwc3 -kmod-usb-dwc3-qcom \
+		-e2fsprogs -kmod-fs-ext4 -losetup
+endef
+TARGET_DEVICES += xiaomi_redmi-ax3000
+
 define Device/xiaomi_redmi-ax3000-ubootmod
 	$(call Device/FitImage)
 	$(call Device/UbiFit)
