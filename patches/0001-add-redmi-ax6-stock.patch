diff --git a/target/linux/qualcommax/ipq807x/base-files/etc/init.d/bootcount b/target/linux/qualcommax/ipq807x/base-files/etc/init.d/bootcount
index e7c2049..b808ca3 100644
--- a/target/linux/qualcommax/ipq807x/base-files/etc/init.d/bootcount
+++ b/target/linux/qualcommax/ipq807x/base-files/etc/init.d/bootcount
@@ -21,5 +21,10 @@ boot() {
 	netgear,wax630)
 		fw_setenv boot_count 0
 	;;
+	redmi,ax6-stock)
+		# 单槽：U-Boot 没有 flag_boot_rootfs，这里只清 OTA 标志
+		fw_setenv flag_ota_reboot 0
+		fw_setenv flag_boot_success 1
+	;;
 	esac
 }
diff --git a/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/platform.sh b/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/platform.sh
index 1ddc73f..1270fc9 100644
--- a/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/platform.sh
+++ b/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/platform.sh
@@ -257,6 +257,22 @@ platform_do_upgrade() {
 		CI_ROOT_UBIPART="rootfs"
 		nand_do_upgrade "$1"
 		;;
+	redmi,ax6-stock)
+		# 单槽 UBI：只有 ubi_kernel + rootfs 两个卷，不做 A/B 切换。
+		# 本机 U-Boot 只认 flag_ota_reboot / flag_boot_success，没有 flag_boot_rootfs，
+		# 所以读到空值一律按 0 处理（写 rootfs 卷），不能 fail-closed。
+		part_num="$(fw_printenv -n flag_boot_rootfs 2>/dev/null || true)"
+		[ -z "$part_num" ] && part_num=0
+		if [ "$part_num" = "1" ]; then
+			CI_UBIPART="rootfs_1"
+		else
+			CI_UBIPART="rootfs"
+		fi
+		fw_setenv flag_boot_rootfs "$part_num"
+		fw_setenv flag_last_success "$part_num"
+		fw_setenv flag_boot_success 0
+		nand_do_upgrade "$1"
+		;;
 	spectrum,sax1v1k)
 		CI_KERNPART="0:HLOS"
 		CI_ROOTPART="rootfs"
